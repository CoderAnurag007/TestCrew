# Copy to .env.production (never commit that file) and fill in every value.
# Generate secrets with:  openssl rand -hex 32

# Domains: point both DNS A records at the server's IP before starting.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Database
POSTGRES_USER=testcrew
POSTGRES_PASSWORD=
POSTGRES_DB=testcrew

# Secrets (64 hex characters each; keep CREDENTIAL_ENCRYPTION_KEY forever,
# it decrypts saved logins and integration tokens)
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# AI (at least one key; without a key the heuristic agents run)
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=

# Workers: each runs up to two audits at once (~1.5 GB RAM per worker)
WORKER_REPLICAS=2

# Optional: screenshots in S3 or Cloudflare R2 instead of the server disk
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: alert emails
SMTP_URL=
ALERT_FROM=TestCrew <alerts@example.com>

# Optional: error tracking
SENTRY_DSN=
