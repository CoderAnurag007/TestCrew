# Application
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=604800

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://auditor:auditor@localhost:5432/auditor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Secrets — generate unique values for any non-local environment
# SESSION_SECRET: at least 32 characters
SESSION_SECRET=local-dev-session-secret-change-me-32
# CREDENTIAL_ENCRYPTION_KEY: 64 hex characters (32 bytes)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional observability
SENTRY_DSN=

# Optional AI (heuristic agents run if no key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=auto
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
ARTIFACT_DIR=.artifacts
# Optional: Playwright browser cache (defaults to .playwright at the repo root in the worker)
PLAYWRIGHT_BROWSERS_PATH=.playwright

# Email (API and worker): password resets, email confirmation and audit alerts.
# Without it, the API logs each email (with its link) instead of sending it.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Snaghunt <hello@snaghunt.com>
# ALERT_FROM=Snaghunt <alerts@example.com>

# Free checks from the landing page (API): most per day in total, and per visitor.
# FREE_SCAN_DAILY_LIMIT=200
# FREE_SCAN_PER_VISITOR=3
